#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# RPM passes zero only for final removal, not upgrade or reinstall.
if [ "$1" = 0 ]; then
    if [ -d /run/systemd/system ]; then
        systemctl --system stop LG_Buddy_lifecycle.service LG_Buddy.service
    fi
    systemctl --system --no-reload disable LG_Buddy_lifecycle.service LG_Buddy.service
fi
exit 0
